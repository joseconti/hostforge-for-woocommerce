{
	"name": "hostforge-for-woocommerce",
	"version": "1.0.0",
	"description": "Modular hosting management platform for WooCommerce",
	"private": true,
	"scripts": {
		"wp-env": "wp-env",
		"wp-env:start": "wp-env start",
		"wp-env:stop": "wp-env stop",
		"wp-env:clean": "wp-env clean all",
		"test:php": "wp-env run phpunit 'cd /var/www/html/wp-content/plugins/hostforge-for-woocommerce && vendor/bin/phpunit'",
		"test:php:unit": "wp-env run phpunit 'cd /var/www/html/wp-content/plugins/hostforge-for-woocommerce && vendor/bin/phpunit --testsuite unit'",
		"test:php:integration": "wp-env run phpunit 'cd /var/www/html/wp-content/plugins/hostforge-for-woocommerce && vendor/bin/phpunit --testsuite integration'",
		"test:php:security": "wp-env run phpunit 'cd /var/www/html/wp-content/plugins/hostforge-for-woocommerce && vendor/bin/phpunit --testsuite security'",
		"test:e2e": "playwright test",
		"test:e2e:admin": "playwright test tests/e2e/admin/",
		"test:e2e:frontend": "playwright test tests/e2e/frontend/",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "npm run test:php && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.49",
		"@wordpress/e2e-test-utils-playwright": "^1.12",
		"@wordpress/env": "^10.0",
		"dotenv": "^16.4"
	}
}
